# Copie ce fichier en .env, ou mieux : lance `python3 store_secret.py`
# qui ecrit .env pour toi avec les bonnes permissions.
#
# .env est ignore par git. Ne le commite jamais, ne le colle jamais dans un chat.

LUNACYCLE_SMTP_HOST=mail.infomaniak.com
LUNACYCLE_SMTP_PORT=465
LUNACYCLE_SMTP_USER=contact@trylunacycle.com
LUNACYCLE_FROM_NAME=Lunacycle

# Le mot de passe d'application genere dans Infomaniak (etape 7).
# PAS le mot de passe du compte Infomaniak.
LUNACYCLE_SMTP_PASSWORD=
